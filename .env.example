# URL this app is deployed at (server-side only, used for OG image resolution)
APP_URL=http://localhost:3000

# Neon Postgres — from your Neon project dashboard, or `npx neon@latest init`
DATABASE_URL=

# Neon Auth (Managed Better Auth) — from `npx neon@latest init` / the Neon console
NEON_AUTH_BASE_URL=
# 32+ char random string, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

# Gemini API — Nano Banana Pro (gemini-3-pro-image)
GEMINI_API_KEY=

# Cloudflare R2 — uploaded photos + generated results
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Stripe — Payment Links + webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
